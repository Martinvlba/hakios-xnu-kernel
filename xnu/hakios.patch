index b595c5624433..ed13d995610f 100644
--- a/osfmk/arm64/status.c
+++ b/osfmk/arm64/status.c
@@ -40,6 +40,9 @@
 #if __has_feature(ptrauth_calls)
 #include <ptrauth.h>
 #endif
+#if HAKIOS_USER_PAC
+#include <arm64/hakios_pac.h>
