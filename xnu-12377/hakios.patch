+#define HAKIOS_TS_LOG_SLOTS             64
+#define HAKIOS_TS_LOG_PER_PROC          16
+#define HAKIOS_TS_LOG_TOTAL_MAX         4096
+#define HAKIOS_TS_LOG_MISMATCH_MAX      256
+
+static struct {
+	int             pid;
+	uint32_t        n;
