+	if (hakios_ts_log_total >= HAKIOS_TS_LOG_TOTAL_MAX) {
+		return false;
+	}
+	__typeof__(&hakios_ts_log_tab[0]) slot = &hakios_ts_log_tab[(unsigned int)*pid % HAKIOS_TS_LOG_SLOTS];
