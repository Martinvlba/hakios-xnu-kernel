+static const char *
+hakios_ts_key_name(int key)
+{
+	return key == HAKIOS_PAC_KEY_IA ? "IA" : key == HAKIOS_PAC_KEY_DA ? "DA" :
+	       key == HAKIOS_PAC_KEY_IB ? "IB" : "DB";
