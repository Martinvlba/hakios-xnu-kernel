######################################################################
#
#  Master Apple configuration file (see the master machine independent
#  configuration file for a description of the file format).
#
#  HakiOS: the generic HakiOS board (MACHINE_CONFIGS=BCM2837, pexpert/pexpert/arm64/BCM2837.h).
#  xnu-12377 has no BCM2837; this is the 8796 HakiOS MASTER.arm64.bcm2837 in the layout of
#  12377's MASTER.arm64.iPhoneOS:
#   - the non-SPTM kernel: config_pmap_ppl selects arm_init.c, arm_vm_init.c and start.s, and
#     nos_arm_pmap the plain osfmk/arm/pmap (PPL itself is XNU_MONITOR, which only Apple boards
#     define in board_config.h: BCM2837 does not, so the pmap runs without PPL as on 8796).
#     No config_sptm, no config_exclaves (doconf is run without -sptm/-exclaves for this board).
#   - nos_arm_asm: the published arm64 assembly (locore.s, cswitch.s, ...).
#   - CPU_COUNTERS_BASE empty: config_cpu_counters builds Apple's PMU drivers (cpc_arm64.c,
#     monotonic_arm64.c, kpc.c); 8796's "kpc" option no longer exists.
#   - config_sched_traditional/config_sched_multiq are gone in 12377: config_sched_timeshare_core.
#   - As on 8796 HakiOS, without: code-signing enforcement, code signature reconstitution,
#     darkboot, img4 (config_img4, config_imageboot_img4: no AppleImage4 library), pgo,
#     rosetta, sched_hygiene_debug, kdp coredump encryption, reslide_shared_cache, and the
#     other iPhoneOS options the 8796 board did not have.
#   - HakiOS additions: hakios_user_pac, no_kextd, mockfs ramfs apfs hfs, nfsserver,
#     HAKIOS_DRIVERS (from config/MASTER.hakios, made by tools/hakios-config.py).
#
######################################################################
#
#  Standard Apple OS Configurations:
#  -------- ----- -- ---------------
#
#  ARM_EXTRAS_BASE = [ config_pmap_ppl nos_arm_pmap nos_arm_asm ]
#  KERNEL_BASE =    [ arm64 xsmall msgb_small config_embedded config_requires_u32_munging hakios_user_pac ARM_EXTRAS_BASE ]
#  KERNEL_RELEASE = [ KERNEL_BASE release ]
