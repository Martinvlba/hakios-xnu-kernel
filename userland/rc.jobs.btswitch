# Commands run by the launchd job com.hakios.demo (see com.hakios.demo.plist).
# Settings > Bluetooth, its switch turned off and on again (the controller's power off and its start anew), for the
# host's screenshots and the kernel's log.
/redwood/bin/rwtouch wait 30 swipe 0.5 0.985 0.5 0.3 200 wait 8
/redwood/bin/lsreg -o com.apple.Preferences
/redwood/bin/rwtouch wait 25 tap 0.5 0.462 wait 12 tap 0.87 0.20 wait 14 tap 0.87 0.20 wait 40
