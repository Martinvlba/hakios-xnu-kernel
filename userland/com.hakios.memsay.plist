<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.hakios.memsay</string>
	<!-- where the kernel's memory is, every 20 s (src/memsay.c): to the console and /private/var/mobile/Media/hakios-klog/wired_*.log. As root (mach_memory_info). -->
	<key>ProgramArguments</key>
	<array>
		<string>/redwood/bin/memsay</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/dev/console</string>
</dict>
</plist>
