# Calculator opened by its identifier and left on screen, for screenshots: with accel_fake=-1,0,0 (gravity to the left)
# it should turn to landscape (the scientific keys) once the device orientation reaches UIKit (TODO 70: rotation)
/redwood/bin/sound_test springboard
/redwood/bin/rwtouch wait 8 notify com.hakios.unlock wait 2 swipe 0.5 0.985 0.5 0.3 200 wait 4
/redwood/bin/lsreg -o com.apple.calculator
/redwood/bin/rwtouch wait 300
