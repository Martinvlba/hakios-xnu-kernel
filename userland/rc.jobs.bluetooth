# Commands run by the launchd job com.hakios.demo (see com.hakios.demo.plist).
# Settings > Bluetooth opened and left open (its switch, "Now discoverable as", the devices it finds), for the host's
# screenshots. With bt=2 and ALLOW="bluetooth BTServer" in the build's environment (devices/akita: Bluetooth).
/redwood/bin/rwtouch wait 30 swipe 0.5 0.985 0.5 0.3 200 wait 8
/redwood/bin/lsreg -o com.apple.Preferences
/redwood/bin/rwtouch wait 25 tap 0.5 0.462 wait 60
